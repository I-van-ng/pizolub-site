# APP_URL: The URL where this site is hosted.
# Used for self-referential links, callbacks, and API endpoints when needed.
APP_URL="MY_APP_URL"

# Server
PORT=3001
NODE_ENV=production
CORS_ORIGIN="http://localhost:3000"

# SMTP Email (optional, falls back to JSON storage)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=accueil@pizolub.ga
