# APP_URL: Optional override for the URL where this site is hosted.
# Render provides RENDER_EXTERNAL_URL automatically on web services.
APP_URL="MY_APP_URL"

# Server
PORT=3001
NODE_ENV=production
CORS_ORIGIN="http://localhost:3000"

# SMTP Email (optional, falls back to JSON storage)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=accueil@pizolub.ga
